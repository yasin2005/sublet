# Copy to .env and fill in. Never commit .env itself.

# MongoDB Atlas connection string
MONGO_URI=
PORT=3000

# HasData — Zillow, Airbnb and Redfin search
HASDATA_API_KEY=
# Requests HasData allows at once on your plan
HASDATA_CONCURRENCY=1

# Guards the endpoints that spend credits. Use 32+ random characters.
AGGREGATOR_API_KEY=

# Apify — FurnishedFinder and Facebook Marketplace
APIFY_TOKEN=
FURNISHEDFINDER_ACTOR_ID=datascrapers/furnishedfinder
FACEBOOK_ACTOR_ID=apify/facebook-marketplace-scraper

# Re-scrape a searched city once its data is older than this (hours).
CACHE_TTL_HOURS=24
# Facebook on each city load costs ~$0.25 of Apify credit.
ON_DEMAND_FACEBOOK=false

# Live scrapes a browser may trigger without the key
UI_FETCH_PER_IP_HOURLY=5
UI_FETCH_DAILY_MAX=50

# MapTiler map tiles (free key at cloud.maptiler.com). Restrict the key to your
# domains in the MapTiler dashboard; it is visible to every visitor.
# Empty = OpenStreetMap fallback, for local development only.
MAPTILER_API_KEY=
MAPTILER_STYLE=streets-v2
