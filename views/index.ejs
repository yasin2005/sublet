<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sublet — short-term housing for interns</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%2315233b'/%3E%3Cpath d='M16 7l9 8h-3v9h-5v-6h-2v6h-5v-9H7z' fill='%23ffffff'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>

  <header class="topbar">
    <a class="brand" href="/">Sublet</a>

    <form id="search-form" class="searchbox" role="search" autocomplete="off">
      <label class="visually-hidden" for="where">City and state</label>
      <input id="where" name="where" type="search" placeholder="City, state — e.g. Seattle, WA" required>
      <button type="submit" id="search-button" aria-label="Search">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </form>

    <!-- Filter pills. Each opens a small panel; the pill label shows what is set. -->
    <nav class="filters" aria-label="Filters">
      <!-- The intern's own trip: dates and where they will work. -->
      <div class="filter" data-filter="trip">
        <button type="button" class="pill pill--trip" aria-expanded="false">Your internship</button>
        <div class="panel panel--wide" hidden>
          <p class="panel__title">Internship dates</p>
          <div class="range">
            <label>Move in<input type="date" id="moveIn"></label>
            <label>Move out<input type="date" id="moveOut"></label>
          </div>
          <p class="panel__note">Hides places that aren't free for your whole stay or need a longer minimum. Listings that don't say stay in.</p>

          <p class="panel__title">Office address</p>
          <input type="text" id="office" class="office-input" placeholder="e.g. 400 Broad St, Seattle" autocomplete="street-address">
          <p id="office-status" class="panel__note" role="status"></p>

          <p class="panel__title">Max distance to office</p>
          <div class="choices choices--row" data-name="maxCommuteMiles">
            <button type="button" data-value="">Any</button>
            <button type="button" data-value="2">2 mi</button>
            <button type="button" data-value="5">5 mi</button>
            <button type="button" data-value="10">10 mi</button>
          </div>

          <div class="panel__actions">
            <button type="button" class="apply" data-apply="trip">Apply</button>
            <button type="button" class="clear" data-clear="trip">Clear</button>
          </div>
        </div>
      </div>

      <div class="filter" data-filter="lease">
        <button type="button" class="pill" aria-expanded="false">Lease</button>
        <div class="panel" hidden>
          <p class="panel__title">Longest minimum lease you can sign</p>
          <div class="choices" data-name="maxLease">
            <button type="button" data-value="">Any</button>
            <button type="button" data-value="30">1 month</button>
            <button type="button" data-value="90">3 months</button>
            <button type="button" data-value="180">6 months</button>
          </div>
          <p class="panel__note">Listings that don't say stay in the results, marked "Lease not listed".</p>
        </div>
      </div>

      <div class="filter" data-filter="price">
        <button type="button" class="pill" aria-expanded="false">Price</button>
        <div class="panel" hidden>
          <p class="panel__title">Monthly rent</p>
          <div class="range">
            <label>Min<input type="number" id="minPrice" min="0" step="50" placeholder="No min" inputmode="numeric"></label>
            <label>Max<input type="number" id="maxPrice" min="0" step="50" placeholder="No max" inputmode="numeric"></label>
          </div>
          <button type="button" class="apply" data-apply="price">Apply</button>
        </div>
      </div>

      <div class="filter" data-filter="beds">
        <button type="button" class="pill" aria-expanded="false">Beds</button>
        <div class="panel" hidden>
          <p class="panel__title">Bedrooms</p>
          <div class="choices choices--row" data-name="minBedrooms">
            <button type="button" data-value="">Any</button>
            <button type="button" data-value="1">1+</button>
            <button type="button" data-value="2">2+</button>
            <button type="button" data-value="3">3+</button>
            <button type="button" data-value="4">4+</button>
          </div>
        </div>
      </div>

      <div class="filter" data-filter="type">
        <button type="button" class="pill" aria-expanded="false">Home type</button>
        <div class="panel" hidden>
          <p class="panel__title">Home type</p>
          <div class="choices" data-name="propertyType">
            <button type="button" data-value="">Any</button>
            <button type="button" data-value="Apartment">Apartment</button>
            <button type="button" data-value="House">House</button>
            <button type="button" data-value="Townhouse">Townhouse</button>
            <button type="button" data-value="Condo">Condo</button>
            <button type="button" data-value="Residence Hall">Residence hall</button>
          </div>
        </div>
      </div>

      <div class="filter" data-filter="more">
        <button type="button" class="pill" aria-expanded="false">More</button>
        <div class="panel panel--wide" hidden>
          <p class="panel__title">Space</p>
          <div class="choices choices--row" data-name="spaceType">
            <button type="button" data-value="">Any</button>
            <button type="button" data-value="Entire Place">Entire place</button>
            <button type="button" data-value="Private Room">Private room</button>
            <button type="button" data-value="Shared Room">Shared room</button>
          </div>
          <p class="panel__title">Furnishing</p>
          <div class="choices choices--row" data-name="isFurnished">
            <button type="button" data-value="">Any</button>
            <button type="button" data-value="true">Furnished only</button>
          </div>
          <p class="panel__title">Listed on</p>
          <div class="choices choices--row" data-name="platform">
            <button type="button" data-value="">All sites</button>
            <button type="button" data-value="University">University intern housing</button>
            <button type="button" data-value="Zillow">Zillow</button>
            <button type="button" data-value="Redfin">Redfin</button>
            <button type="button" data-value="Airbnb">Airbnb</button>
            <button type="button" data-value="FurnishedFinder">FurnishedFinder</button>
            <button type="button" data-value="FacebookMarketplace">Facebook</button>
          </div>
        </div>
      </div>

      <button type="button" id="reset-filters" class="reset" hidden>Reset</button>
    </nav>
  </header>

  <main class="layout" data-view="list">
    <section class="map-pane" aria-label="Map">
      <div id="map"></div>

      <label class="move-search">
        <input type="checkbox" id="move-search" checked>
        Search as I move the map
      </label>
      <button type="button" id="search-area" class="search-area" hidden>Search this area</button>

      <div class="legend" aria-label="Pin colors">
        <span><i class="dot dot--fit"></i>Lease of 3 months or less</span>
        <span><i class="dot dot--unknown"></i>Lease not listed</span>
        <span><i class="dot dot--long"></i>Longer lease</span>
        <span><i class="dot dot--university"></i>University intern housing</span>
      </div>
    </section>

    <section class="list-pane" aria-label="Results">
      <div class="list-head">
        <h1 id="heading">Find a place for your internship</h1>
        <div class="list-head__row">
          <p id="summary" class="summary">Search a city to see rentals from Zillow, Redfin, Airbnb and FurnishedFinder.</p>
          <label class="sort">
            <span class="visually-hidden">Sort by</span>
            <select id="sort">
              <option value="best">Best for short stays</option>
              <option value="price">Price: low to high</option>
              <option value="newest">Newest</option>
              <option value="commute" hidden>Closest to office</option>
            </select>
          </label>
        </div>
        <div id="progress" class="progress" hidden role="status" aria-live="polite">
          <span class="spinner" aria-hidden="true"></span>
          <span id="progress-text"></span>
        </div>
      </div>

      <div id="results" class="grid" aria-live="polite"></div>
      <div id="empty" class="empty" hidden></div>
      <nav id="pager" class="pager" aria-label="Pages" hidden></nav>
    </section>

    <button type="button" id="view-toggle" class="view-toggle">Map</button>
  </main>

  <!-- Listing detail. -->
  <dialog id="detail" class="detail" aria-labelledby="detail-price">
    <button type="button" class="detail__close" id="detail-close" aria-label="Close">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <div id="detail-body"></div>
  </dialog>

  <script src="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js"></script>
  <%# Map settings from .env, set by server.js. Every value here is public. %>
  <script>window.SUBLET_CONFIG = <%- JSON.stringify(mapConfig).replace(/</g, '\\u003c') %>;</script>
  <script src="/js/app.js"></script>
</body>
</html>
